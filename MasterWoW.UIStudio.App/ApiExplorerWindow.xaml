<Window x:Class="MasterWoW.UIStudio.App.ApiExplorerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TBC API Explorer" Width="1100" Height="720" Background="#17191D" Foreground="#E7EAF0">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="210"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8"><ComboBox x:Name="Kind" Width="170" DockPanel.Dock="Right" SelectionChanged="Filter_Changed"><ComboBoxItem IsSelected="True">All</ComboBoxItem><ComboBoxItem>Widget</ComboBoxItem><ComboBoxItem>Global</ComboBoxItem><ComboBoxItem>Event</ComboBoxItem><ComboBoxItem>Template</ComboBoxItem><ComboBoxItem>Constant</ComboBoxItem></ComboBox><TextBox x:Name="Search" Background="#101216" Foreground="White" FontSize="14" TextChanged="Filter_Changed" ToolTip="Search name, owner, category, description or source"/></DockPanel>
  <DataGrid x:Name="Entries" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="White" Foreground="Black" RowBackground="White" AlternatingRowBackground="#E8EDF3" SelectionChanged="Entries_SelectionChanged"><DataGrid.Resources><Style TargetType="DataGridColumnHeader"><Setter Property="Foreground" Value="Black"/><Setter Property="Background" Value="#D7DEE8"/></Style><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="Black"/></Style></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="API" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="*"/><DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="*"/><DataGridTextColumn Header="Stock TBC" Binding="{Binding Availability}" Width="*"/><DataGridTextColumn Header="Emulator" Binding="{Binding Implementation}" Width="*"/></DataGrid.Columns></DataGrid>
  <DockPanel Grid.Row="2" Margin="0,8,0,0"><Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Open documentation" Click="OpenDocumentation_Click"/><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#101216" Foreground="#DDE5F2"/></DockPanel>
 </Grid>
</Window>
