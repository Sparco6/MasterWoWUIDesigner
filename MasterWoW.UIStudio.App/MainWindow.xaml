<Window x:Class="MasterWoW.UIStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit" Title="{Binding Title}" Width="1500" Height="960" MinWidth="1050" MinHeight="700" Background="#17191D" Foreground="#D9DEE7" KeyDown="Window_KeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#20242B"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#303744"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#485365"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#16191E"/><Setter Property="Foreground" Value="#E8ECF2"/><Setter Property="BorderBrush" Value="#46505E"/></Style>
  <Style TargetType="MenuItem"><Setter Property="Background" Value="#252A32"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="TreeViewItem"><Setter Property="Foreground" Value="#E7ECF5"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#101216"/></Style>
 </Window.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="#252A32" Foreground="White"><MenuItem Header="_File"><MenuItem Header="_Open Lua…" Click="Open_Click"/><MenuItem Header="_Save Lua" Click="Save_Click"/><MenuItem Header="Save Lua _As…" Click="SaveAs_Click"/></MenuItem><MenuItem Header="_Edit"><MenuItem Header="_Undo" Click="Undo_Click"/><MenuItem Header="_Redo" Click="Redo_Click"/><Separator/><MenuItem Header="Discard Studio-only layout overrides…" Click="DiscardDesignerOverrides_Click" ToolTip="Delete the preview-only .mwstudio.layout.json file and reload the original Lua layout."/></MenuItem><MenuItem Header="_Preview"><MenuItem Header="_Reload" Click="Reload_Click"/><Separator/><MenuItem x:Name="ShowBottomPanelsMenu" Header="Show Lua editor and bottom panels" IsCheckable="True" IsChecked="True" Click="ToggleBottomPanels_Click"/><MenuItem x:Name="ShowPropertiesMenu" Header="Show Properties panel" IsCheckable="True" IsChecked="True" Click="TogglePropertiesPanel_Click"/><MenuItem x:Name="PreviewOnlyMenu" Header="Preview-only mode (F11)" IsCheckable="True" Click="PreviewOnly_Click"/><Separator/><MenuItem x:Name="AutoAcceptEditsMenu" Header="Auto-accept designer changes" IsCheckable="True" Click="AutoAcceptEdits_Click" ToolTip="Source-mapped controls are written directly to Lua. Unmapped generated controls are preview-only and stored in .mwstudio.layout.json; they do not affect WoW."/></MenuItem><MenuItem Header="_Tools"><MenuItem Header="TBC Client"><MenuItem Header="Set Interface Root…" Click="SetInterfaceRoot_Click"/><MenuItem Header="Scan Interface" Click="ScanInterface_Click"/><MenuItem Header="Rebuild Cache" Click="RebuildCache_Click"/><Separator/><MenuItem Header="Asset Browser" Click="AssetBrowser_Click"/><MenuItem Header="Texture Browser" Click="AssetBrowser_Click"/><MenuItem Header="Template Explorer" Click="TemplateExplorer_Click"/><MenuItem Header="API Usage / Scan Report" Click="ScanReport_Click"/><MenuItem Header="Interface Explorer" IsEnabled="False" ToolTip="Stage D"/></MenuItem><MenuItem Header="API Documentation"><MenuItem Header="Open API Explorer" Click="ApiExplorer_Click"/><MenuItem Header="Refresh Historical Metadata" IsEnabled="False" ToolTip="Explicit background refresh UI is pending; cached/offline import is available."/></MenuItem></MenuItem><MenuItem Header="TBC API Explorer" Click="ApiExplorer_Click"/><MenuItem Header="Help" IsEnabled="False" ToolTip="Planned"/></Menu>
  <ToolBar DockPanel.Dock="Top" Background="#20242B"><Button Content="Open" Click="Open_Click"/><Button Content="Save" Click="Save_Click"/><Button Content="Reload  Ctrl+R" Click="Reload_Click"/><Separator/><TextBlock Text="Resolution" VerticalAlignment="Center" Margin="8,0,4,0"/><ComboBox x:Name="Resolution" Width="125" SelectionChanged="Resolution_Changed"><ComboBoxItem IsSelected="True">1280x720</ComboBoxItem><ComboBoxItem>1024x768</ComboBoxItem><ComboBoxItem>1920x1080</ComboBoxItem><ComboBoxItem>2560x1440</ComboBoxItem></ComboBox><TextBlock Text="UI scale" VerticalAlignment="Center" Margin="12,0,4,0"/><ComboBox x:Name="Scale" Width="80" SelectionChanged="Scale_Changed"><ComboBoxItem>0.64</ComboBoxItem><ComboBoxItem>0.768</ComboBoxItem><ComboBoxItem IsSelected="True">1.0</ComboBoxItem></ComboBox><Button Content="Screenshot BG…" Click="Background_Click"/></ToolBar>
  <StatusBar DockPanel.Dock="Bottom" Background="#20242B"><TextBlock Text="{Binding ClientStatus}"/><Separator/><ProgressBar x:Name="ScanProgress" Width="180" Height="12" Visibility="Collapsed"/><TextBlock x:Name="ScanStatus"/></StatusBar>
  <Grid><Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition x:Name="EditorSplitterRow" Height="5"/><RowDefinition x:Name="EditorRow" Height="2*"/><RowDefinition x:Name="BottomSplitterRow" Height="5"/><RowDefinition x:Name="BottomPanelRow" Height="175"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PropertiesSplitterColumn" Width="5"/><ColumnDefinition x:Name="PropertiesColumn" Width="280"/></Grid.ColumnDefinitions>
   <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Panel}" Padding="8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="FRAME TREE" FontWeight="Bold" Margin="4,4,4,8"/><TreeView x:Name="FrameTree" Background="#181B20" Foreground="#DCE3ED" SelectedItemChanged="FrameTree_SelectedItemChanged"/></DockPanel></Border><GridSplitter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Background="#30353E"/>
   <Border Grid.Row="0" Grid.Column="2" Background="#0A0B0D" Padding="8"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Viewbox Stretch="Uniform" StretchDirection="DownOnly"><Grid x:Name="PreviewHost" Width="1280" Height="720" Background="#111820"><Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.65"/><Canvas x:Name="PreviewCanvas" Width="1280" Height="720" MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/></Grid></Viewbox></ScrollViewer></Border><GridSplitter Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" Background="#30353E"/>
   <Border Grid.Row="0" Grid.Column="4" Background="{StaticResource Panel}" Padding="10"><ScrollViewer><StackPanel><TextBlock Text="PROPERTIES" FontWeight="Bold" Margin="0,2,0,12"/><TextBlock Text="Name"/><TextBox Text="{Binding Selected.Name, Mode=OneWay}" Margin="0,2,0,8"/><TextBlock Text="Type"/><TextBox Text="{Binding Selected.Type, Mode=OneWay}" Margin="0,2,0,8"/><TextBlock Text="Width"/><TextBox x:Name="WidthBox" Margin="0,2,0,8"/><TextBlock Text="Height"/><TextBox x:Name="HeightBox" Margin="0,2,0,8"/><TextBlock Text="Anchor X"/><TextBox x:Name="Xbox" Margin="0,2,0,8"/><TextBlock Text="Anchor Y"/><TextBox x:Name="Ybox" Margin="0,2,0,8"/><Button Content="Apply safe literal patch" Click="ApplyProperties_Click"/><TextBlock Text="Only source-mapped numeric literals are editable. Expressions are never overwritten." Foreground="#E5B95C" TextWrapping="Wrap" Margin="0,8"/></StackPanel></ScrollViewer></Border>
   <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" VerticalAlignment="Stretch" Background="#30353E"/><Border Grid.Row="2" Grid.ColumnSpan="5" Background="#15181D"><DockPanel><TextBlock DockPanel.Dock="Top" Text="LUA CODE EDITOR" FontWeight="Bold" Margin="9,6"/><avalon:TextEditor x:Name="Editor" FontFamily="Consolas" FontSize="14" ShowLineNumbers="True" Background="#101216" Foreground="#D8DEE9" SyntaxHighlighting="Lua" TextChanged="Editor_TextChanged"/></DockPanel></Border><GridSplitter Grid.Row="3" Grid.ColumnSpan="5" VerticalAlignment="Stretch" Background="#30353E"/>
   <TabControl Grid.Row="4" Grid.ColumnSpan="5" Background="#20242B"><TabItem Header="Errors / Warnings"><ListBox x:Name="Diagnostics" Background="#15181D" Foreground="#E3E6EB"/></TabItem><TabItem Header="API Calls"><ListBox x:Name="ApiCalls" Background="#15181D" Foreground="#B8D7FF"/></TabItem><TabItem Header="Change Log"><ListBox ItemsSource="{Binding ChangeLog}" Background="#15181D" Foreground="#E8D37A"/></TabItem><TabItem Header="Events" IsEnabled="False" ToolTip="Phase 2"/><TabItem Header="AIO Inspector"><DockPanel><Grid DockPanel.Dock="Right" Width="370" Margin="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Payload JSON (use {} for defaults)" Foreground="White" Margin="2"/><TextBox Grid.Row="1" x:Name="AioPayloadJson" Text="{}" AcceptsReturn="True" Margin="2" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/><Button Grid.Row="2" Content="Show / invoke selected handler" Click="InvokeAio_Click" Margin="2"/></Grid><ListBox x:Name="AioHandlers" DisplayMemberPath="Handler" Background="#15181D" Foreground="#B8D7FF"/></DockPanel></TabItem></TabControl>
  </Grid>
 </DockPanel>
</Window>
