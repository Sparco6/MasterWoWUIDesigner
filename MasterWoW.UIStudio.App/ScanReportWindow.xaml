<Window x:Class="MasterWoW.UIStudio.App.ScanReportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TBC Client Scan Report" Width="800" Height="620" Background="#17191D" Foreground="White"><TabControl Margin="10"><TabItem Header="Summary"><TextBox x:Name="Summary" IsReadOnly="True" Background="#101216" Foreground="White" FontFamily="Consolas" TextWrapping="Wrap"/></TabItem><TabItem Header="API Usage"><ListView x:Name="Apis" Background="#101216" Foreground="White"><ListView.View><GridView><GridViewColumn Header="API" Width="300" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Calls" Width="100" DisplayMemberBinding="{Binding UsageCount}"/><GridViewColumn Header="Files" Width="100" DisplayMemberBinding="{Binding SourceFiles.Count}"/></GridView></ListView.View></ListView></TabItem><TabItem Header="Diagnostics"><ListBox x:Name="Diagnostics" Background="#101216" Foreground="White"/></TabItem></TabControl></Window>
