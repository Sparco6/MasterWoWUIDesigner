<Window x:Class="MasterWoW.UIStudio.App.TemplateExplorerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TBC Template Explorer" Width="950" Height="650" Background="#17191D" Foreground="White"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBox x:Name="Search" Grid.ColumnSpan="2" Margin="0,0,0,8" TextChanged="Search_Changed"/><ListBox x:Name="Templates" Grid.Row="1" Background="#101216" Foreground="White" DisplayMemberPath="Name" SelectionChanged="Templates_SelectionChanged"/><TextBox x:Name="Details" Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Background="#101216" Foreground="White" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,8,0,0" Content="Instantiate in Preview" Click="Preview_Click"/></Grid></Window>
